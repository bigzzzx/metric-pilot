DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
APP_ENCRYPTION_KEY=
VECTOR_STORE_BACKEND=milvus
# For local development, run scripts/start-milvus-tunnel.ps1 first.
# The tunnel script reconnects automatically. Override these only on a local
# workstation; production deployments should use private service addresses.
DATA_AGENT_SSH_SERVER=ubuntu@your-server.example.com
DATA_AGENT_SSH_KEY_PATH=
MILVUS_URI=http://127.0.0.1:19530
MILVUS_DATABASE=data_agent
MILVUS_COLLECTION=knowledge_chunks_bge_small_zh_v1
CATALOG_MILVUS_COLLECTION=catalog_metadata_bge_small_zh_v1
CATALOG_EMBEDDING_BATCH_SIZE=16
# Privacy opt-in: set to milvus only when the deployment is authorized to send user-memory text to the configured embedding service and vector database.
MEMORY_VECTOR_BACKEND=disabled
MEMORY_MILVUS_COLLECTION=user_memories_bge_small_zh_v1
MEMORY_VECTOR_SCORE_THRESHOLD=0.42
EMBEDDING_BACKEND=tei
EMBEDDING_BASE_URL=http://127.0.0.1:8081
RERANK_BACKEND=tei
RERANK_BASE_URL=http://127.0.0.1:8082
# Redis remains private on the server and is reached through the local SSH tunnel.
REDIS_URL=redis://127.0.0.1:16379/2
TOOL_CACHE_PREFIX=data-agent:tool-cache:v1
TOOL_CACHE_MAX_ENTRIES=10000
AGENT_CACHE_PREFIX=data-agent:agent-cache:v1
AGENT_CACHE_MAX_ENTRIES=5000
TURN_RESPONSE_CACHE_TTL_SECONDS=60
TURN_RESPONSE_CACHE_MAX_PAYLOAD_BYTES=262144
AGENT_PLAN_CACHE_TTL_SECONDS=300
AGENT_ANSWER_CACHE_TTL_SECONDS=300
AGENT_ROUTE_CACHE_TTL_SECONDS=300
KNOWLEDGE_OWNER_QUOTA_BYTES=2147483648
KNOWLEDGE_BASE_QUOTA_BYTES=1073741824
KNOWLEDGE_EMBEDDING_BATCH_SIZE=32
KNOWLEDGE_STALE_PROCESSING_SECONDS=900
KNOWLEDGE_INDEX_GENERATION=knowledge-bge-small-zh-v2
